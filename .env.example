# Copy to .env for local development. In production these are set in the Render dashboard, never committed.
# Every variable the server reads is listed here; the ones marked (optional) have safe defaults.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
# Performance logging: requests slower than this (ms) are logged as [SLOW REQUEST]
SLOW_REQUEST_THRESHOLD_MS=1200

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/grains-shop

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<minimum-64-char-random-string>
JWT_REFRESH_SECRET=<minimum-64-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# (optional) key for the HMAC that protects one-time sign-in / reset codes. Falls back to the JWT secrets.
OTP_HMAC_SECRET=

# ── Frontend / cookies ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# (optional) more allowed origins, comma separated (e.g. a custom domain next to the netlify.app one)
FRONTEND_URLS=
# (optional) set to the parent domain (e.g. .example.co.ke) once the shop and API share one registrable
# domain: the refresh cookie then becomes first-party and Safari/iOS stops signing people out
COOKIE_DOMAIN=
# (optional) lax | strict | none. Default is 'none' in production without COOKIE_DOMAIN (the old cross-site
# setup). The shop reaches the API through Netlify's same-origin /api proxy, so 'lax' works and blocks
# cross-site cookie sending - set COOKIE_SAMESITE=lax once you have confirmed that is the only path used.
COOKIE_SAMESITE=

# ── Reverse proxy / client address ────────────────────────────────────────────
# How many proxies sit in front of the API. Decides req.ip (rate limits, M-Pesa callback IP check).
TRUST_PROXY_HOPS=1
# (optional) header an edge you trust sets to the REAL visitor address, e.g. x-nf-client-connection-ip (Netlify)
# or cf-connecting-ip (Cloudflare). Only set it for a header the edge overwrites on every request.
# Check what the server sees at GET /api/admin/control-center/network (superadmin), from two different networks.
CLIENT_IP_HEADER=
# (optional) 'mongo' shares rate-limit counters between server instances. Needed the day you run more than one.
RATE_LIMIT_STORE=

# ── M-Pesa (Safaricom Daraja) ─────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Safaricom's STK callback target. Prefer including MPESA_CALLBACK_TOKEN: .../api/payments/mpesa/callback/<token>
MPESA_CALLBACK_URL=https://yourdomain.co.ke/api/payments/mpesa/callback
MPESA_ENV=sandbox
# (optional) random string; if set, a callback whose URL ends /<token> is accepted whichever proxy delivered it
MPESA_CALLBACK_TOKEN=
# (optional) extra Safaricom source IPs to allow, comma separated (production only)
MPESA_CALLBACK_EXTRA_IPS=
# (optional) CustomerPayBillOnline (default) or CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=
# (optional) ms to wait for Daraja's STK answer (default 12000; the Netlify proxy gives up at ~26s overall)
MPESA_STK_TIMEOUT_MS=

# ── Cloudinary (product images) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMS - Africa's Talking ────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ── Email - Gmail SMTP ────────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Vittorios Grains & Cereals
# (optional) a personal Gmail allows roughly 500 recipients a day. Ordinary notifications stop at
# EMAIL_DAILY_LIMIT minus EMAIL_CRITICAL_RESERVE; the reserve is kept for sign-in / reset codes and alerts.
EMAIL_DAILY_LIMIT=480
EMAIL_CRITICAL_RESERVE=80

# ── Security alerts (who gets told when something looks wrong) ────────────────
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# ── Error tracking ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Backups ───────────────────────────────────────────────────────────────────
# Use an absolute path on a PERSISTENT disk in production (Render: mount a disk at /data, then /data/backups).
# If omitted, backups go to ../runtime-data/backups outside the app tree.
BACKUP_STORAGE_DIR=
# 32-byte hex (64 chars) AES-256-GCM key: openssl rand -hex 32. Unset = backups stored unencrypted.
BACKUP_ENCRYPTION_KEY=
# (optional) largest restore upload in MB (default 200)
BACKUP_UPLOAD_MAX_MB=

# ── Hosting / keep-alive ──────────────────────────────────────────────────────
# Render sets RENDER_EXTERNAL_URL itself; SELF_URL is for other hosts. Used by the keep-alive pinger.
RENDER_EXTERNAL_URL=
SELF_URL=
# Set to false once you are on a paid Render plan (it never spins down, so the pinger is just noise).
KEEP_ALIVE_ENABLED=

# ── Performance tuning (optional, defaults are fine) ──────────────────────────
# Seconds-scale cache for per-branch settings, in ms. 0 disables caching. Multi-instance: keep it small.
SETTINGS_CACHE_TTL_MS=5000
# Checkouts handled at once per branch per server process (the rest queue for a moment instead of colliding).
ORDER_PLACEMENT_CONCURRENCY=3
# How long (ms) one order keeps retrying a database write conflict before answering 503.
ORDER_RETRY_BUDGET_MS=8000
# Worker threads that compute password hashes (bcryptjs is CPU-bound; on the main thread a login burst froze the
# whole API). 1 is right for a small instance; use 2 on a plan with 2+ vCPUs. 0 = hash on the main thread (capped).
BCRYPT_WORKERS=1
# Only used when BCRYPT_WORKERS=0 or worker threads are unavailable: hashes computed at once on the main thread.
BCRYPT_MAX_CONCURRENT=2

# ── Seed / one-off scripts ────────────────────────────────────────────────────
BRANCH_NAME=
BRANCH_SLUG=
BRANCH_PHONE=
BRANCH_LOCATION=

# ── LOCAL-DEVELOPMENT-ONLY ESCAPE HATCHES ─────────────────────────────────────
# Both flags below DISABLE a security control. They exist so local development
# does not need production SMS/OTP delivery or an exact origin match. Never set
# SKIP_ORIGIN_CHECK in a deployed environment. SKIP_2FA is currently set on the live
# Render service as a deliberate owner decision (admin sign-in is password-only with
# the 15-minute lock after 5 wrong passwords); see CLAUDE.md before changing it.

# Skip the 2FA OTP challenge for admin/superadmin login.
SKIP_2FA=

# Skip the CSRF Origin/Referer check on POST /api/auth/refresh.
# Useful when the Vite dev server is not on the exact FRONTEND_URL origin (it falls back
# to :5174 if :5173 is taken, which would otherwise 403 token refresh).
SKIP_ORIGIN_CHECK=

# KRA refund-reason code sent on an eTIMS credit note (take it from the eTIMS code table KRA gave you; confirm in the sandbox)
ETIMS_REFUND_REASON_CODE=13
