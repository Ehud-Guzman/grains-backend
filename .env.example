# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/grains-shop

# JWT
JWT_ACCESS_SECRET=<minimum-64-char-random-string>
JWT_REFRESH_SECRET=<minimum-64-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://yourdomain.co.ke/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications - Africa's Talking (Phase 2)
AT_API_KEY=
AT_USERNAME=

# Error Tracking
SENTRY_DSN=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ── LOCAL-DEVELOPMENT-ONLY ESCAPE HATCHES ─────────────────────────────────────
# Both flags below DISABLE a security control. They exist so local development
# does not need production SMS/OTP delivery or an exact origin match. Never set
# either in a deployed environment — `server.js` refuses to start in production
# with MPESA_ENV != production, and warns loudly when SKIP_2FA is set there.

# Skip the 2FA OTP challenge for admin/superadmin login.
# 2FA is enforced for those two roles in EVERY environment (not just production)
# because gating it on NODE_ENV left staging/QA password-only and made the
# feature untestable. Without this flag, local developer logins would need an
# OTP delivered over SMS — and Africa's Talking is on sandbox, so it would never
# arrive. Leave unset (or false) anywhere a real login happens.
SKIP_2FA=

# Skip the CSRF Origin/Referer check on POST /api/auth/refresh.
# Useful when the frontend dev server is not on the exact FRONTEND_URL origin
# (Vite falls back to :5174 if :5173 is taken, which would otherwise 403 token
# refresh). Never enable this on a deployed environment: /auth/refresh mints a
# new access token from an ambient HttpOnly cookie, making it the endpoint where
# origin validation matters most.
SKIP_ORIGIN_CHECK=

# Performance logging
SLOW_REQUEST_THRESHOLD_MS=1200

# Backup storage
# Use an absolute path in production, e.g. D:\GrainsSystemData\backups
# If omitted, backups are stored outside the backend app tree in ../runtime-data/backups
BACKUP_STORAGE_DIR=
